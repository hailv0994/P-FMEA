# Copy this file to `.env` and fill in your Google Gemini API key.
# Get a key at: https://aistudio.google.com/apikey
#
# NOTE: This is a pure frontend (Vite) app, so the key is exposed in the
# browser bundle. Use a restricted/throttled key for demos. For production,
# proxy the Gemini call through a backend instead.

VITE_GEMINI_API_KEY=

# Optional: override the model (defaults to gemini-2.0-flash)
VITE_GEMINI_MODEL=gemini-2.0-flash
